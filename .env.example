# ===== Server =====
PORT=3000
HOST=127.0.0.1
# true = pakai data contoh (tanpa Elasticsearch), cocok untuk mencoba UI
DEMO_MODE=false

# Opsional: lindungi aplikasi dengan token sederhana (header: x-api-token)
APP_TOKEN=
# Host tambahan yang boleh membuka aplikasi (pisahkan koma). localhost, 127.0.0.1 dan ::1 selalu diizinkan.
# Contoh bila diakses lewat nama host lain: ALLOWED_HOSTS=soc.lan
ALLOWED_HOSTS=

# Brankas key (agar API key bisa dimasukkan lewat halaman aplikasi). Wajib diisi bersama APP_TOKEN.
# Buat dengan: openssl rand -base64 32   (jangan dibagikan, jangan di-commit, simpan terpisah dari backup folder data)
VAULT_KEY=
# Alternatif: VAULT_KEY_FILE=/run/secrets/vault_key

# ===== Elasticsearch =====
ES_NODE=https://localhost:9200
# Pilih salah satu: API key (disarankan) ATAU username+password
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
# Set false hanya untuk lab dengan self-signed certificate. Produksi: gunakan ES_CA_CERT
ES_TLS_REJECT_UNAUTHORIZED=true
ES_CA_CERT=

# Index alert Elastic Security (default space)
ES_ALERT_INDEX=.alerts-security.alerts-default
# Index log untuk pencarian event terkait (pivot). Pisahkan dengan koma.
ES_EVENT_INDEX=logs-*,filebeat-*,winlogbeat-*

# ===== Kibana (opsional, untuk mengubah status alert) =====
KIBANA_URL=
KIBANA_API_KEY=

# ===== Threat Intelligence (opsional) =====
VT_API_KEY=
ABUSEIPDB_API_KEY=
# Lama cache hasil IOC (menit)
IOC_CACHE_MINUTES=60

# ===== Auto-triage & verdict otomatis =====
# true = alert dianalisa otomatis (evidence, event terkait, validasi IOC, TTP MITRE ATT&CK, narasi) dan verdict langsung ditetapkan.
AUTO_ENRICH=true
# all = semua verdict otomatis | tp_only = hanya True Positive | off = hanya rekomendasi
# Verdict yang sudah ditetapkan analis tidak pernah ditimpa. Status alert di Elastic tidak pernah diubah otomatis.
AUTO_APPLY_VERDICT=all
AUTO_SEVERITIES=high,critical
AUTO_POLL_SECONDS=60
AUTO_MAX_PER_CYCLE=10
# Rentang crawling alert baru (menit). Bebas, maksimal 525600 (1 tahun). 1440 = 24 jam, 43200 = 30 hari
AUTO_LOOKBACK_MINUTES=1440
# Bila aplikasi sempat mati, jendela diperluas otomatis sampai batas ini (jam) agar alert tidak terlewat
AUTO_MAX_CATCHUP_HOURS=168
# Batas jumlah alert per analisa massal (tombol "Jalankan" di UI, rentang waktu bebas)
AUTO_BACKFILL_MAX=300
# Lama hasil analisa disimpan (hari). 0 = tanpa batas
ENRICH_RETENTION_DAYS=365
# Jeda antar lookup API eksternal (ms). 16000 untuk VirusTotal gratis (4/menit). 0 untuk API berbayar.
AUTO_TI_INTERVAL_MS=16000
# Jendela event terkait (± menit dari waktu alert), maksimal 43200
AUTO_WINDOW_MINUTES=15

# Zona waktu pada laporan PDF
REPORT_TZ=Asia/Jakarta
